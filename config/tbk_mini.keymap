/*
 * ============================================================================
 *  Sputnik / Corne handwired  -  42 keys
 *  Layout US International
 * ============================================================================
 *  zmk.dev/docs/keymaps/list-of-keycodes
 * ============================================================================
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* LIVELLO 0 */
        base_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T          &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G          &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B          &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                      &kp LALT  &mo 1  &kp SPACE      &kp RET  &mo 2  &kp LGUI
            >;
        };

        /* 1 */
        lower_layer {
            display-name = "Signs";
            bindings = <
&kp TAB    &kp N1    &kp N2     &kp N3     &kp N4    &kp N5          &kp N6     &kp N7    &kp N8    &kp N9     &kp N0    &kp BSPC
&kp LCTRL  &kp EXCL  &kp AT     &kp HASH   &kp DLLR  &kp PRCNT       &kp CARET  &kp AMPS  &kp STAR  &kp LPAR   &kp RPAR  &kp GRAVE
&kp LSHFT  &kp BSLH  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT        &kp LBRC   &kp RBRC  &kp PIPE  &kp UNDER  &kp PLUS  &kp TILDE
                            &trans  &trans  &kp SPACE                &kp RET  &trans  &kp LALT
            >;
        };

        /* 2 */
        raise_layer {
            display-name = "Vim";
            bindings = <
&kp TAB    &kp F1   &kp F2   &kp F3  &kp F4  &kp F5           &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp INS  &kp BSPC
&kp LCTRL  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10          &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans   &trans
&kp LSHFT  &kp F11  &kp F12  &trans  &trans  &trans           &kp DEL   &kp CAPS   &kp PSCRN  &trans     &trans   &trans
                        &trans  &trans  &kp SPACE             &kp RET  &trans  &trans
            >;
        };

        /* 3 */
        adjust_layer {
            display-name = "BT";
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none     &kp LG(RET)  &kp LG(B)  &none  &none  &none        &none
&none        &none         &none         &none         &none         &none     &none        &none      &none  &none  &none        &none
&bootloader  &sys_reset    &none         &none         &none         &none     &none        &none      &none  &none  &sys_reset   &bootloader
                                      &trans  &trans  &none          &none  &trans  &none
            >;
        };
    };
};
